# Self-contained build: compiles the exporter in Docker for the platform of
# the Docker host (for example linux/arm64 on Apple Silicon). The default
# Dockerfile needs a binary from promu in .build/ instead.
#
#   docker build -f Dockerfile.build -t blackbox_exporter:kafka .
#   docker build -f Dockerfile.build --build-arg KAFKA_CONFLUENT=0 -t blackbox_exporter:kafka-go .
#
# KAFKA_CONFLUENT=1 (default): cgo build with the kafka client libraries
#   "segmentio" and "confluent" (bundled librdkafka, glibc).
# KAFKA_CONFLUENT=0: pure Go build, kafka client library "segmentio" only.

FROM golang:1.27-bookworm AS build
ARG KAFKA_CONFLUENT=1
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN if [ "$KAFKA_CONFLUENT" = "1" ]; then \
      CGO_ENABLED=1 go build -trimpath -tags confluent -o /blackbox_exporter . ; \
    else \
      CGO_ENABLED=0 go build -trimpath -o /blackbox_exporter . ; \
    fi

# glibc runtime for the cgo build. Same Debian release as the build stage.
FROM gcr.io/distroless/base-debian12
COPY --from=build /blackbox_exporter /bin/blackbox_exporter
COPY blackbox.yml /etc/blackbox_exporter/config.yml
EXPOSE 9115
ENTRYPOINT ["/bin/blackbox_exporter"]
CMD ["--config.file=/etc/blackbox_exporter/config.yml"]

